@model Expedition
@{
    ViewData["Title"] = "Add new item";
}

<h1>File your expedition.</h1>
<p class="text-muted">File the results of your expeditions to our database. Your work keeps the company happy.</p>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CrewNumber" class="form-label"></label>
        <input asp-for="CrewNumber" class="form-control" minlength=2 />
        <span asp-validation-for="CrewNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Moon" class="form-label"></label>
        <input asp-for="Moon" class="form-control" />
        <span asp-validation-for="Moon" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExpeditionDate" class="form-label"></label>
        <input asp-for="ExpeditionDate" class="form-control" />
        <span asp-validation-for="ExpeditionDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <input asp-for="Notes" class="form-control" />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-primary">File Expedition</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}