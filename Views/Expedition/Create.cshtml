@using scrap_depot.ViewModels
@model ExpeditionFormViewModel
@{
    ViewData["Title"] = "Add new item";
}

<h1>File your expedition.</h1>
<p class="text-muted">File the results of your expeditions to our database. Your work keeps the company happy.</p>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Expedition.CrewNumber" class="form-label"></label>
        <input asp-for="Expedition.CrewNumber" class="form-control" minlength=2 />
        <span asp-validation-for="Expedition.CrewNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Expedition.Moon" class="form-label"></label>
        <input asp-for="Expedition.Moon" class="form-control" />
        <span asp-validation-for="Expedition.Moon" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Expedition.ExpeditionDate" class="form-label"></label>
        <input asp-for="Expedition.ExpeditionDate" class="form-control" />
        <span asp-validation-for="Expedition.ExpeditionDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Expedition.Notes" class="form-label"></label>
        <input asp-for="Expedition.Notes" class="form-control" />
        <span asp-validation-for="Expedition.Notes" class="text-danger"></span>
    </div>

    <!--this sucks!-->
    <div class="mb-3">
        <label asp-for="Expedition.ScrapIds" class="form-label"></label>
        <select asp-for="Expedition.ScrapIds" asp-items="Model.ScrapChoices" class="form-select" multiple>
        </select>
        <span asp-validation-for="Expedition.ScrapIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">File Expedition</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}