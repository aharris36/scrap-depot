@model List<Scrap>
@{
    ViewData["Title"] = "Scrap Collected";
}

    <ul class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var scrap in Model)
        {
            <div class="col">
                <partial name="_ScrapCard" model="scrap" />
                <li><a href="/Scrap/Details/@scrap.Id">@scrap.Name</a> — @scrap.Deposited deposited.</li>
            </div>
            
        }
    </ul>

