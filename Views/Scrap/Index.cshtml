@model List<Scrap>
@{
    ViewData["Title"] = "Scrap Collected";
}

    <div class="d-flex justify-content-between">
        <!--tbd: change this conditional to if the user's crew number is not null -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span>Your crew have collected x credits.</span>
    }
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary mb-4">＋ Register scrap item</a>
    }
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var scrap in Model)
        {
            <div class="col">
                <partial name="_ScrapCard" model="scrap" />
            </div>
            
        }
    </div>
    
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-12/homework-checks.js"></script>
}