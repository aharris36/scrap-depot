@model Scrap
@{
    ViewData["Title"] = $"Remove item: {Model.Name}";
}

<h1>Remove item</h1>
<p class="text-muted">This will permanently remove the item from the database. </p>

<div class="col-md-4 mb-4">
    <partial name="_ScrapCard" model="Model" />
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Remove item</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Keep it</a>
</form>